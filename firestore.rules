rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helpers
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Collections
    match /compliance_verifications/{verificationId} {
      function isValidVerification(data) {
        return data.keys().hasAll(['id', 'topicId', 'userId', 'confirmedAt', 'status'])
          && data.id is string && data.id.size() <= 128
          && data.topicId is string && data.topicId.size() <= 128
          && data.userId is string && data.userId.size() <= 128
          && data.confirmedAt is string && data.confirmedAt.size() <= 64
          && data.status in ['confirmed', 'pending', 're_sign_required', 'pending_late_approval', 'pending_wbt_verification', 'rejected', 'not_participated'];
      }
      allow get: if isValidId(verificationId);
      allow list: if isSignedIn();
      allow create: if isValidId(verificationId) && isValidVerification(incoming());
      allow update: if isValidId(verificationId) 
        && incoming().id == existing().id
        && incoming().topicId == existing().topicId
        && incoming().userId == existing().userId;
      allow delete: if isValidId(verificationId);
    }

    match /user_passwords/{userId} {
      function isValidPassword(data) {
        return data.keys().hasAll(['userId', 'email', 'passwordHash', 'updatedAt'])
          && data.userId is string && data.userId.size() <= 128
          && data.email is string && data.email.size() <= 256
          && data.passwordHash is string && data.passwordHash.size() <= 256;
      }
      allow get: if isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isValidId(userId) && isValidPassword(incoming());
      allow update: if isValidId(userId) 
        && isValidPassword(incoming())
        && incoming().userId == existing().userId;
      allow delete: if isValidId(userId);
    }

    match /topics/{topicId} {
      function isValidTopic(data) {
        return data.keys().hasAll(['id', 'title', 'type', 'targetGroup', 'content', 'effectiveDate', 'dueDate'])
          && data.id is string && data.id.size() <= 128
          && data.title is string && data.title.size() <= 300;
      }
      allow get: if isValidId(topicId);
      allow list: if isSignedIn();
      allow create: if isValidId(topicId) && isValidTopic(incoming());
      allow update: if isValidId(topicId) 
        && incoming().id == existing().id;
      allow delete: if isValidId(topicId);
    }

    match /topic_assignments/{assignmentId} {
      function isValidAssignment(data) {
        return data.keys().hasAll(['id', 'topicId', 'userId', 'status', 'assignedAt'])
          && data.id is string && data.id.size() <= 128
          && data.topicId is string && data.topicId.size() <= 128
          && data.userId is string && data.userId.size() <= 128;
      }
      allow get: if isValidId(assignmentId);
      allow list: if isSignedIn();
      allow create: if isValidId(assignmentId) && isValidAssignment(incoming());
      allow update: if isValidId(assignmentId) 
        && incoming().id == existing().id
        && incoming().topicId == existing().topicId
        && incoming().userId == existing().userId;
      allow delete: if isValidId(assignmentId);
    }

    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['id', 'uNumber', 'name', 'email', 'isAls', 'isLead', 'isAdmin'])
          && data.id is string && data.id.size() <= 128
          && data.email is string && data.email.size() <= 256;
      }
      allow get: if isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isValidId(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) 
        && isValidUser(incoming())
        && incoming().id == existing().id;
      allow delete: if isValidId(userId);
    }
  }
}
