rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Compliance verifications (confirmations, signatures, acknowledgments)
    match /compliance_verifications/{verificationId} {
      allow read: if isValidId(verificationId);
      allow create: if isValidId(verificationId)
        && incoming().keys().hasAll(['id', 'topicId', 'userId', 'confirmedAt', 'status'])
        && incoming().id is string && incoming().id.size() <= 128
        && incoming().topicId is string && incoming().topicId.size() <= 128
        && incoming().userId is string && incoming().userId.size() <= 128
        && incoming().confirmedAt is string && incoming().confirmedAt.size() <= 64
        && incoming().status in ['confirmed', 'pending', 're_sign_required', 'pending_late_approval', 'rejected'];
      allow update: if isValidId(verificationId)
        && incoming().keys().hasAll(['id', 'topicId', 'userId', 'confirmedAt', 'status'])
        && incoming().status in ['confirmed', 'pending', 're_sign_required', 'pending_late_approval', 'rejected'];
      allow delete: if isValidId(verificationId);
    }

    // User passwords (stored password hashes)
    match /user_passwords/{userId} {
      allow read: if isValidId(userId);
      allow create, update: if isValidId(userId)
        && incoming().keys().hasAll(['userId', 'email', 'passwordHash', 'updatedAt'])
        && incoming().userId is string && incoming().userId.size() <= 128
        && incoming().email is string && incoming().email.size() <= 256
        && incoming().passwordHash is string && incoming().passwordHash.size() <= 256;
      allow delete: if isValidId(userId);
    }

    // Topics collection
    match /topics/{topicId} {
      allow read: if isValidId(topicId);
      allow create, update: if isValidId(topicId)
        && incoming().keys().hasAll(['id', 'title', 'type', 'targetGroup', 'content', 'effectiveDate', 'dueDate'])
        && incoming().id is string && incoming().id.size() <= 128
        && incoming().title is string && incoming().title.size() <= 300;
      allow delete: if isValidId(topicId);
    }

    // Staff roster users
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create, update: if isValidId(userId)
        && incoming().keys().hasAll(['id', 'uNumber', 'name', 'email', 'isAls', 'isLead', 'isAdmin'])
        && incoming().id is string && incoming().id.size() <= 128
        && incoming().email is string && incoming().email.size() <= 256;
      allow delete: if isValidId(userId);
    }
  }
}
