# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted.
# Used for constructing magic link verification URLs (e.g. http://localhost:3000 or production Cloud Run URL).
APP_URL="http://localhost:3000"

# TRANSACTIONAL EMAIL PROVIDER (Server-side only secrets):
# RESEND_API_KEY: API key for Resend transactional email delivery service (https://resend.com).
# If omitted, system runs in dev simulator mode capturing magic links to server delivery log for instant testing.
RESEND_API_KEY="re_123456789_abcdefg"


