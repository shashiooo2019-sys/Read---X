{
  "entities": {
    "User": {
      "title": "User",
      "description": "Platform user record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "team": { "type": "string" },
        "department": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Topic": {
      "title": "Topic",
      "description": "Compliance topic directive to be read and signed",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string" },
        "targetGroup": { "type": "string" },
        "dueDate": { "type": "string" },
        "publishedDate": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "closeOption": { "type": "string" }
      },
      "required": ["id", "title", "type", "targetGroup", "status"]
    },
    "TopicConfirmation": {
      "title": "TopicConfirmation",
      "description": "Record of user acknowledgment for a specific topic",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "topicId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "confirmedAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "topicId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of user profiles"
    },
    "/topics/{topicId}": {
      "schema": { "$ref": "#/entities/Topic" },
      "description": "Collection of compliance topics"
    },
    "/confirmations/{confirmationId}": {
      "schema": { "$ref": "#/entities/TopicConfirmation" },
      "description": "Collection of topic confirmations and acknowledgments"
    }
  }
}
